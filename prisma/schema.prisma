generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum LeadStatus {
  SETTING
  CLOSING
  ABGESCHLOSSEN
  VERLOREN
}

enum LeadSource {
  WEBSITE
  MESSE
  KALTAKQUISE
  EMPFEHLUNG
  SONSTIGES
}

enum CoreBusiness {
  WEG_VERWALTUNG
  MIETVERWALTUNG
  SE_VERWALTUNG
  MAKLER
  SONSTIGES
}

enum AgeRange {
  A18_29
  A30_39
  A40_49
  A50_59
  A60_PLUS
}

enum ActivityType {
  KONTAKTIERT
  EMAIL
  MEETING
  NOTIZ
  STATUS
}

enum ContactOutcome {
  NICHT_ERREICHT
  VORZIMMER
  ENTSCHEIDER_NICHT_VOR_ORT
  RUECKRUF
  KEIN_INTERESSE
  TERMIN_SETTING
  TERMIN_CLOSING
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(MEMBER)
  createdAt    DateTime   @default(now())
  leads        Lead[]     @relation("LeadOwner")
  activities   Activity[]
  tasks        Task[]     @relation("TaskAssignee")
  createdTasks Task[]     @relation("TaskCreator")
}

model Lead {
  id                String         @id @default(cuid())
  company           String?
  firstName         String?
  lastName          String?
  position          String?
  phone             String?
  email             String?
  website           String?
  street            String?
  zip               String?
  city              String?
  source            LeadSource?
  referredBy        String?
  status            LeadStatus     @default(SETTING)
  coreBusiness      CoreBusiness[]
  employeeCount     Int?
  propertyCount     Int?
  unitCount         Int?
  ageRange          AgeRange?
  ownerId           String?
  owner             User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Normalisierte Felder für die Duplikat-Erkennung
  emailNormalized   String?
  phoneNormalized   String?
  companyNormalized String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activities        Activity[]
  tasks             Task[]

  @@index([status])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([companyNormalized])
  @@index([updatedAt])
}

model Activity {
  id        String          @id @default(cuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  outcome   ContactOutcome?
  note      String?
  createdAt DateTime        @default(now())

  @@index([leadId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime
  done        Boolean   @default(false)
  completedAt DateTime?
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([done, dueDate])
  @@index([assigneeId, done])
}
